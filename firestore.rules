rules_version = '2';

// =============================================================================
// BiciFastness — reglas de Firestore
//
// MODELO: no hay servidor HTTP delante. El navegador escribe directamente en
// Firestore, asi que estas reglas SON el control de acceso, no un complemento.
// El worker de GitHub Actions usa el Admin SDK y se las salta por diseno: es
// quien decide si un viaje se aprueba.
//
// Regla de oro: el cliente puede PROPONER (crear un viaje pendiente), nunca
// DECIDIR (marcarlo como verificado, darse puntos o hacerse administrador).
//
// La version que provoco el hackeo tenia `allow read, write: if request.auth != null`
// en usuarios, tiempos_viaje, config, reportes y secrets. Con una cuenta recien
// creada y la consola del navegador se podia uno hacer admin (el id del
// documento era el email), autoverificarse los tiempos, leer las API keys y
// borrar los records de los demas.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Ayudantes ---------------------------------------------------------
    function autenticado() {
      return request.auth != null;
    }

    function esYo(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    // El rol vive en un custom claim firmado dentro del token de Firebase Auth,
    // que solo puede escribir el Admin SDK. NO en un documento que el propio
    // usuario pueda modificar.
    function esAdmin() {
      return autenticado() && request.auth.token.admin == true && segundoFactorAdmin();
    }

    // Verificacion en dos pasos de la administracion (assets/js/dos-pasos.js).
    //
    // Mientras `config/seguridad.adminMfa` no este encendido, el rol basta: es
    // lo que deja entrar a activarla sin quedarse fuera. Encendido, el token
    // tiene que llevar el segundo paso (TOTP, firmado por Firebase) y de hace
    // menos de dos horas: el panel lo vuelve a pedir en cada entrada, y una
    // sesion robada no sirve de admin pasado ese rato.
    //
    // Solo se evalua con el claim `admin` (el `&&` de arriba corta antes), asi
    // que a nadie mas le cuesta ninguna lectura.
    function segundoFactorAdmin() {
      return !exists(/databases/$(database)/documents/config/seguridad)
        || get(/databases/$(database)/documents/config/seguridad).data.get('adminMfa', false) != true
        || segundoFactorReciente();
    }

    function segundoFactorReciente() {
      return request.auth.token.firebase.get('sign_in_second_factor', '') == 'totp'
        && request.auth.token.auth_time > request.time.toMillis() / 1000 - 7200;
    }

    // --- Web abierta o en construccion (assets/js/puerta.js) ----------------
    // En obras solo escriben la administracion y la lista blanca. Estar en la
    // lista NO es ser administrador: el claim `admin` va aparte.
    //
    // Sin `config/acceso` la web esta abierta: un documento que falta no puede
    // cerrar la web a todo el mundo.
    function webAbierta() {
      return !exists(/databases/$(database)/documents/config/acceso)
        || get(/databases/$(database)/documents/config/acceso).data.get('modo', 'abierta') != 'obras';
    }

    // Con el correo VERIFICADO: si no, cualquiera se registra con contraseña
    // usando el correo de alguien de la lista y entra.
    function enListaBlanca() {
      return autenticado()
        && request.auth.token.get('email', null) is string
        && request.auth.token.get('email_verified', false) == true
        && exists(/databases/$(database)/documents/acceso_lista/$(request.auth.token.email.lower()));
    }

    function puedeUsarLaWeb() {
      return esAdmin() || webAbierta() || enListaBlanca();
    }

    // Una cuenta suspendida no escribe nada mas: ni trayectos, ni
    // valoraciones, ni clanes, ni foto. Antes la suspension solo se notaba en
    // el panel y la cuenta podia seguir subiendo.
    function cuentaActiva() {
      return autenticado()
        && (!exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('suspendido', false) != true);
    }

    function datos() { return request.resource.data; }
    function previo() { return resource.data; }

    // Campos que cambian entre el documento viejo y el nuevo.
    function cambia() {
      return datos().diff(previo()).affectedKeys();
    }

    // --- Freno de escritura (#62) -------------------------------------------
    //
    // EL PROBLEMA. El cupo de tres viajes al dia lo comprueba el worker, o sea
    // CUANDO EL VIAJE YA ESTA ESCRITO. Entre medias no habia nada: una cuenta
    // con sesion podia crear miles de viajes y una captura de 700 KB por cada
    // uno desde la consola del navegador, sin saltarse ninguna regla. Con 20.000
    // escrituras al dia en el plan Spark, eso es tirar la web hasta medianoche.
    //
    // COMO SE FRENA. Las reglas no saben contar, pero si saben mirar como va a
    // quedar un documento DESPUES de esta misma escritura (`getAfter`). Asi que
    // el navegador lleva su propio contador en `cupos/{uid}` y lo actualiza en
    // el MISMO lote que el viaje. Dos cosas lo hacen infalsificable:
    //
    //   1. Un lote no puede escribir dos veces el mismo documento, y la regla de
    //      `cupos` solo deja subir cada contador de uno en uno. O sea: como
    //      mucho un viaje y una captura por lote.
    //   2. El ID del viaje TIENE QUE SER el numero que va a marcar el contador.
    //      Dos viajes en el mismo lote pedirian el mismo id, y el segundo falla
    //      porque `create` sobre un id que ya existe no pasa.
    //
    // Sin lo segundo esto no serviria de nada: un lote de quinientos viajes
    // subiendo el contador una sola vez pasaria entero.
    //
    // EL DIA ES UTC, no Madrid. A proposito: `request.time` es lo unico que hay
    // aqui y no se puede convertir. Por eso el tope de abajo NO es el cupo del
    // juego — ese lo sigue poniendo el worker, en hora de Madrid — sino un techo
    // antiinundacion holgado: un dia UTC pisa dos dias de Madrid, asi que quien
    // gaste sus tres viajes a las 23:00 y otros tres a las 01:00 sigue por
    // debajo. Un tope ajustado bloquearia a gente legitima de madrugada.
    function diaUTC() {
      return int(request.time.toMillis() / 86400000);
    }

    // Como queda `cupos/{uid}` DESPUES de este lote.
    function cupoTras(uid) {
      return getAfter(/databases/$(database)/documents/cupos/$(uid)).data;
    }

    // Techo diario por cuenta. Tres veces el cupo del juego
    // (`LIMITES.VIAJES_POR_DIA`), que hay un test que lo ata.
    function topeDiario() { return 10; }

    // --- Perfiles ----------------------------------------------------------
    match /usuarios/{uid} {
      /**
       * El registro de consentimiento, que el RGPD exige poder demostrar: QUE
       * se acepto, CUANDO y sobre QUE version del texto.
       *
       * Estaba como `consentimiento is map` y nada mas, o sea que cabia dentro
       * cualquier cosa de cualquier tamaño. En un campo cualquiera eso ya
       * sobra; en el que sirve de PRUEBA de un consentimiento, mas: un registro
       * en el que el interesado puede escribir lo que quiera vale poco como
       * prueba.
       *
       * La forma es exactamente la que escriben `crearPerfil` y `aceptarLegal`,
       * los dos unicos sitios que lo tocan, y los dos escriben el mapa entero.
       *
       * OJO, PENDIENTE (#55): `aceptadoEn` lo pone el navegador, asi que la
       * FECHA la elige el interesado. Para lo que es esto deberia venir del
       * servidor (`request.time`), pero eso cambia el tipo del campo y hay que
       * mirar que no rompa a los perfiles que ya existen.
       */
      function consentimientoValido() {
        return datos().consentimiento is map
          && datos().consentimiento.keys().hasOnly(['terminos', 'privacidad'])
          && datos().consentimiento.keys().hasAll(['terminos', 'privacidad'])
          && bloqueDeConsentimiento(datos().consentimiento.terminos)
          && bloqueDeConsentimiento(datos().consentimiento.privacidad);
      }

      function bloqueDeConsentimiento(bloque) {
        return bloque is map
          && bloque.keys().hasOnly(['version', 'aceptadoEn'])
          && bloque.version is string && bloque.version.size() <= 20
          && bloque.aceptadoEn is string && bloque.aceptadoEn.size() <= 40;
      }

      // CERRADO hasta que las clasificaciones salgan de los agregados (#35).
      //
      // Esto era `allow read: if true`, y con razon aparente: los rankings
      // necesitan nombre, avatar y puntuacion, y se ven sin sesion. El problema
      // es que el MISMO documento lleva el correo, asi que "publico para el
      // ranking" significaba publicar 175 direcciones.
      //
      // Y no era solo dato viejo: la regla de alta de abajo admitia un campo
      // `email`, o sea que el correo se habria seguido filtrando despues de
      // migrar. Ya no lo admite. El correo vive en Firebase Auth, que es su
      // sitio; duplicarlo en una coleccion publica era el fallo.
      //
      // Cuando #35 sirva los rankings desde `agregados/` (solo nombre, avatar y
      // puntos), esta coleccion puede quedarse cerrada para siempre.
      allow read: if esYo(uid) || esAdmin();

      // El alta la hace el propio usuario, pero con TODOS los contadores a cero
      // y sin poder inventarse el rol. Si se pudiera crear con biciRating alto o
      // con esAdmin, volveriamos al agujero original.
      allow create: if esYo(uid)
        && datos().uid == uid
        && datos().keys().hasOnly([
          'uid', 'username', 'usernameLower', 'avatarUrl',
          'biciRating', 'viajesVerificados', 'puntosPorRuta', 'logros',
          'clanId', 'favoritas', 'suspendido', 'creado', 'consentimiento',
          'bienvenidaEnviada'
        ])
        // Nace en `false`, no ausente: es lo que permite al worker encontrar a
        // quien falta por saludar con una consulta indexada en vez de recorrer
        // `usuarios` entera. Un campo que falta no lo encuentra ninguna
        // consulta de Firestore.
        && datos().bienvenidaEnviada == false
        && datos().username is string
        && datos().username.size() >= 3 && datos().username.size() <= 24
        // Letras, numeros, espacio, guion y guion bajo: lo mismo que pide la
        // portada. Sin esto, desde la consola se creaban nombres con emojis,
        // caracteres invisibles o que imitan a otro, y se publicaban tal cual.
        && datos().username.matches('^[\\p{L}\\p{N}_ -]+$')
        && datos().usernameLower == datos().username.lower()
        && datos().biciRating == 0
        && datos().viajesVerificados == 0
        && datos().puntosPorRuta.size() == 0
        && datos().logros.size() == 0
        && datos().clanId == null
        && datos().suspendido == false
        // El avatar de serie es un SVG en data: (`avatarPorDefecto`), y se
        // publica tal cual en las clasificaciones. Sin esto cabia cualquier
        // URL —un pixel de rastreo en un servidor ajeno— o un texto de 1 MiB.
        && datos().avatarUrl is string && datos().avatarUrl.size() <= 2000
        && datos().avatarUrl.matches('^data:image/svg[+]xml,.*')
        && datos().favoritas is list && datos().favoritas.size() <= 3
        && consentimientoValido()
        && puedeUsarLaWeb();

      // Solo se puede tocar lo cosmetico y las rutas ancladas. La puntuacion,
      // las insignias y el estado de la cuenta los escribe unicamente el worker.
      //
      // `avatarUrl` NO esta, y es a proposito. Se escribe una sola vez, al
      // crear el perfil, con la URL que genera `avatarPorDefecto` a partir del
      // nombre; la subida de avatar se retiro (ver `paginas/yo.js`) y desde
      // entonces no hay una sola linea que lo modifique. Dejarlo abierto
      // significaba poder apuntarlo a cualquier sitio, sin ninguna validacion
      // de formato — el `color` de los clanes si la tiene — y ese campo se
      // publica tal cual en los agregados de las clasificaciones. O sea que
      // cualquiera podia hacer que el navegador de todo el que abriera un
      // ranking pidiera una imagen a un servidor suyo, y quedarse con las IP.
      // Si algun dia vuelve la subida de avatar, vuelve aqui con su patron.
      allow update: if esYo(uid)
        // `avisosCorreo` es la preferencia de correo. Es un booleano suyo y
        // solo suyo: darse de baja no puede depender de que un administrador lo
        // haga por ti (RGPD).
        && cambia().hasOnly(['favoritas', 'consentimiento', 'avisosCorreo', 'fotoMini', 'tutorialVisto'])
        && (!('favoritas' in datos()) || datos().favoritas.size() <= 3)
        // El tutorial de la primera vez (assets/js/tutorial.js): solo se puede
        // marcar como visto, nunca desmarcar.
        && (!('tutorialVisto' in cambia()) || datos().tutorialVisto == true)
        // Solo cuando SE ESCRIBE. Es lo que hay que vigilar —que nadie meta
        // ahi lo que quiera— y ademas no deja fuera a ningun perfil viejo:
        // exigirlo siempre habria dejado sin poder tocar sus preferencias a
        // cualquiera cuyo registro no tenga hoy exactamente esta forma, por
        // ejemplo si viene de la v1.
        && (!('consentimiento' in cambia()) || consentimientoValido())
        // La miniatura de su foto (40 px), para los rankings. Solo una imagen
        // pequeña en base64: nunca una URL (ver el comentario de `avatarUrl`).
        && (!('fotoMini' in cambia()) || datos().fotoMini == null
            || (datos().fotoMini is string && datos().fotoMini.size() <= 3000
                && datos().fotoMini.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/]+=*$')));

      // Avisos push (#33).
      //
      // Es suyo y solo suyo: donde recibe las notificaciones y cuales quiere.
      // Va aparte de la lista cosmetica porque `push` es un mapa y conviene que
      // se vea que aqui NO entra nada mas — ni la puntuacion ni el estado de la
      // cuenta comparten regla con esto.
      //
      // Darse de baja no puede depender de nadie, igual que con el correo.
      //
      // CON TOPE, y este importa mas que los otros. `push.enviar` recorre la
      // lista y hace UNA peticion al servicio de avisos por cada entrada. Sin
      // limite, una sola cuenta con la lista inflada convierte cada aviso en
      // miles de peticiones salientes: se come el tiempo de ejecucion del
      // worker —que es de GitHub Actions y esta contado— y ademas lo pone a
      // aporrear servidores de terceros en nombre del proyecto.
      //
      // Diez son de sobra: son navegadores distintos de la misma persona, y el
      // worker ademas va limpiando las que el servicio ya no reconoce.
      //
      // Las claves tambien se acotan. Era el unico `update` del fichero sin
      // ninguna comprobacion de lo que se escribe, y `push` es un mapa: cabe
      // dentro cualquier cosa, hasta llenar el documento.
      // `ultimoAvisoRacha` lo escribe el worker; va en la lista porque
      // `datos()` es el documento RESULTANTE y si ya existe tiene que poder
      // seguir ahi.
      allow update: if esYo(uid)
        && cambia().hasOnly(['push'])
        && datos().push.keys().hasOnly(['suscripciones', 'avisos', 'ultimoAvisoRacha'])
        && (!('suscripciones' in datos().push)
            || (datos().push.suscripciones is list
                && datos().push.suscripciones.size() <= 10))
        // Las preferencias son un interruptor por tipo de aviso: pocas claves.
        && (!('avisos' in datos().push)
            || (datos().push.avisos is map && datos().push.avisos.size() <= 20));

      // El clan al que pertenece (#29).
      //
      // Estaba fuera de las dos listas, asi que NADIE podia escribirlo: crear un
      // clan, aceptar a alguien o expulsarlo fallaban contra las reglas y la
      // gestion de clanes no funcionaba desde el navegador.
      //
      // Irse siempre se puede. Entrar, solo si el clan YA te lista como
      // miembro: sin esa comprobacion, cualquiera se declara miembro de
      // cualquier clan escribiendo un campo suyo, y como la puntuacion del clan
      // se sumaba consultando por este campo, se le podia inflar a un clan
      // ajeno con cuentas nuevas.
      allow update: if esYo(uid)
        && cambia().hasOnly(['clanId'])
        && (
          datos().clanId == null
          || get(/databases/$(database)/documents/clanes/$(datos().clanId)).data.miembros.hasAny([uid])
        );

      // La administracion concede insignias y suspende cuentas. No puede tocar
      // la puntuacion: esa la calcula el worker a partir de los tiempos, y
      // dejarla editable a mano reabriria la puerta a inflarla.
      // `recompensas` son los banners y lemas ganados (assets/data/recompensas.js):
      // los concede la administracion, nunca el propio piloto.
      allow update: if esAdmin()
        && cambia().hasOnly(['logros', 'suspendido', 'motivoSuspension', 'recompensas'])
        && (!('recompensas' in cambia())
            || (datos().recompensas is list && datos().recompensas.size() <= 100));

      allow delete: if false;
    }

    // Peticiones de borrado de cuenta (RGPD art. 17).
    // Borrar el usuario de Firebase Auth exige el Admin SDK, que en el navegador
    // no existe: el piloto deja la peticion aqui y el worker la ejecuta.
    // Historial de temporadas cerradas. Las subcolecciones NO heredan las
    // reglas del documento padre, asi que sin este bloque caeria en el cierre
    // por defecto y ni su dueño podria leerlo.
    //
    // Vive colgando del usuario a proposito: asi se borra con su cuenta, sin
    // tener que acordarse de ir a limpiarlo a otro sitio.
    match /usuarios/{uid}/temporadas/{temporada} {
      allow read: if esYo(uid) || esAdmin();
      // Lo escribe el worker al cerrar la temporada.
      allow write: if false;
    }

    match /solicitudes_borrado/{uid} {
      allow read: if esYo(uid) || esAdmin();
      allow create: if esYo(uid)
        && datos().keys().hasOnly(['uid', 'creado', 'confirmacion'])
        && datos().uid == uid
        && datos().confirmacion == 'BORRAR MI CUENTA';
      allow update, delete: if false;
    }

    match /nombres_usuario/{nombre} {
      // Se consulta para avisar de que un nombre esta cogido, pero la unicidad
      // real la garantiza el worker: las reglas no pueden hacer transacciones.
      allow read: if autenticado();
      // Solo el nombre de TU perfil, en el mismo lote que lo crea (getAfter).
      // Antes bastaba con poner tu uid: una sola cuenta podia reservar
      // cualquier cantidad de nombres y dejar sin ellos a quien llegara despues.
      allow create: if esYo(datos().uid)
        && datos().keys().hasOnly(['uid', 'creado'])
        && datos().creado == request.time
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.usernameLower == nombre;
      allow update, delete: if false;
    }

    // --- Viajes ------------------------------------------------------------
    match /tiempos_viaje/{viajeId} {
      // CIERRE DE EMERGENCIA — hasta que termine la migracion (issue #54).
      //
      // La linea comentada de abajo es correcta para el modelo v2, donde el
      // viaje NO contiene datos personales: la captura vive en `capturas`, que
      // solo lee la administracion.
      //
      // Pero los viajes que hay en produccion son de la v1 y llevan dentro
      // `email_real` y `foto_url` con la captura entera en base64. "Verificado
      // es publico" aplicado a esos documentos publica el correo y la captura
      // de cada persona a cualquiera, sin sesion.
      //
      // Se restaura la linea comentada SOLO cuando ningun documento de
      // tiempos_viaje tenga ya esos dos campos.
      allow read: if esAdmin() || esYo(previo().uid);
      // allow read: if previo().verificado == true || esAdmin() || esYo(previo().uid);

      // El piloto PROPONE un viaje. Nace siempre pendiente y sin verificar: el
      // veredicto lo pone el worker, que se salta estas reglas.
      // `correcciones` es telemetria del lector del navegador (#8): que campos
      // ha tenido que corregir la persona sobre lo que se leyo en su captura.
      // NO decide nada y no puede: quien engañe no manda la marca. Lo que
      // compara de verdad es el worker, releyendo la captura por su cuenta.
      // Se admite, se acota y se ignora para cualquier decision.
      allow create: if esYo(datos().uid)
        && datos().keys().hasOnly([
          'uid', 'username', 'ruta', 'tiempoSegundos', 'tiempoFormateado',
          'fechaViaje', 'estado', 'verificado', 'creado', 'correcciones', 'capturaId',
          'metadatos'
        ])
        // `metadatos` son las DOS unicas etiquetas del EXIF que el navegador
        // lee antes de comprimir: el programa que toco la captura y la marca
        // del movil (#66). Nunca las de posicion — el EXIF de una foto lleva
        // donde se hizo, y las capturas se guardan en Firestore.
        //
        // Lo declara el cliente, asi que quien sepa lo que hace no lo manda. Se
        // usa igual porque solo puede QUITARSE puntos a si mismo: no hay forma
        // de mandarlo por otro, y no mandarlo deja las cosas como estaban. Por
        // eso la señal que alimenta pesa 15 y no 45.
        //
        // `capturadaEn` es el DIA del fichero ('YYYY-MM-DD'), para el
        // antifraude de fechas: una captura no puede ser anterior al viaje que
        // muestra. Mismo razonamiento: solo puede restar a quien lo manda.
        && (!datos().keys().hasAny(['metadatos']) || (
          datos().metadatos.keys().hasOnly(['software', 'marca', 'capturadaEn'])
          && (!('capturadaEn' in datos().metadatos)
            || (datos().metadatos.capturadaEn is string
              && datos().metadatos.capturadaEn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (!('software' in datos().metadatos)
            || (datos().metadatos.software is string && datos().metadatos.software.size() <= 40))
          && (!('marca' in datos().metadatos)
            || (datos().metadatos.marca is string && datos().metadatos.marca.size() <= 40))
        ))
        // Varios viajes pueden apuntar a la MISMA captura: una imagen del
        // historial de la app lleva dos o tres trayectos (#11). Por eso el
        // documento de la captura ya no se llama forzosamente como el viaje.
        && (!datos().keys().hasAny(['capturaId'])
          || (datos().capturaId is string && datos().capturaId.size() <= 64))
        && (!datos().keys().hasAny(['correcciones']) || datos().correcciones.keys().hasOnly([
          'confianza', 'origen', 'destino', 'tiempoSegundos', 'desfaseSegundos'
        ]))
        && datos().estado == 'pendiente'
        && datos().verificado == false
        && datos().ruta is string
        && datos().ruta.matches('^[0-9]{3}[A-Z]?-[0-9]{3}[A-Z]?$')
        && datos().tiempoSegundos is int
        && datos().tiempoSegundos >= 30
        && datos().tiempoSegundos <= 7200
        && datos().fechaViaje is string
        && datos().fechaViaje.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && datos().creado == request.time
        // El nombre que viaja con el trayecto es el del perfil. Sin esto se
        // podia subir con el nombre de otro, y el aviso de "te han quitado el
        // record" salia a su nombre.
        && datos().username == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.username
        && datos().tiempoFormateado is string && datos().tiempoFormateado.size() <= 16
        && (!datos().keys().hasAny(['correcciones'])
          || ((!('confianza' in datos().correcciones) || datos().correcciones.confianza == null || datos().correcciones.confianza is number)
            && (!('origen' in datos().correcciones) || datos().correcciones.origen is bool)
            && (!('destino' in datos().correcciones) || datos().correcciones.destino is bool)
            && (!('tiempoSegundos' in datos().correcciones) || datos().correcciones.tiempoSegundos is bool)
            && (!('desfaseSegundos' in datos().correcciones) || datos().correcciones.desfaseSegundos == null || datos().correcciones.desfaseSegundos is number)))
        // El freno de escritura (#62). El id LLEVA DENTRO el numero que va a
        // marcar el contador, asi que solo cabe un viaje por lote.
        && viajeId == request.auth.uid + '_' + string(diaUTC())
          + '_' + string(cupoTras(request.auth.uid).viajes)
        && cupoTras(request.auth.uid).dia == diaUTC()
        && cupoTras(request.auth.uid).viajes <= topeDiario()
        && puedeUsarLaWeb()
        && cuentaActiva();

      // El dueno solo puede pedir revision humana de un rechazo automatico
      // (art. 22.3 RGPD). No puede tocar el tiempo, la ruta ni el veredicto.
      allow update: if esYo(previo().uid)
        && previo().estado == 'rechazado'
        && previo().revisadoPor == 'automatico'
        // `get`: un rechazo que nunca se impugno no lleva el campo, y leerlo
        // a pelo es un error de evaluacion que deniega.
        && previo().get('impugnado', false) != true
        // Mientras el worker guarde la captura: sin ella no hay nada que
        // revisar, y la impugnacion llegaba al panel sin imagen.
        && previo().get('capturaCaduca', null) is timestamp
        && previo().capturaCaduca > request.time
        && cambia().hasOnly(['estado', 'impugnado', 'alegacion', 'impugnadoEn'])
        && datos().estado == 'revision'
        && datos().impugnado == true
        && datos().alegacion is string
        && datos().alegacion.size() >= 15
        && datos().alegacion.size() <= 600;

      // La administracion resuelve la cola. `recalculoPendiente` avisa al worker
      // de que tiene que rehacer la clasificacion: hacerlo desde el navegador
      // costaria cientos de lecturas de la cuota diaria.
      allow update: if esAdmin()
        && cambia().hasOnly([
          'estado', 'verificado', 'revisadoPor', 'revisadoEn',
          'motivoRevision', 'recalculoPendiente'
        ])
        && datos().estado in ['aprobado', 'rechazado', 'revision'];

      allow delete: if false;
    }

    // --- Capturas -----------------------------------------------------------
    // En el plan Spark no hay Cloud Storage, asi que la imagen viaja aqui. Vive
    // en su propia coleccion, separada del viaje, para que el ranking no arrastre
    // megas de fotos en cada lectura y para poder cerrarla del todo.
    match /capturas/{viajeId} {
      // Ni siquiera su autor la relee: no le hace falta y asi no se puede raspar
      // la coleccion. La administracion la ve desde el panel.
      allow read: if esAdmin();

      allow create: if autenticado()
        && esYo(datos().uid)
        && datos().keys().hasOnly(['uid', 'datos', 'creado'])
        && datos().datos is string
        && datos().datos.matches('^data:image/(jpeg|png|webp);base64,.*')
        // 700 KB de base64 (~500 KB de imagen). El limite duro de un documento
        // de Firestore es 1 MiB; dejamos margen para el resto de campos.
        && datos().datos.size() < 700000
        // El mismo freno que en los viajes (#62), y aqui es el que mas importa:
        // son 700 KB cada una. Sin esto, una cuenta recien registrada podia
        // llenar el proyecto de capturas hasta agotar la cuota del dia.
        && viajeId == request.auth.uid + '_' + string(diaUTC())
          + '_c' + string(cupoTras(request.auth.uid).capturas)
        && cupoTras(request.auth.uid).dia == diaUTC()
        && cupoTras(request.auth.uid).capturas <= topeDiario();

      allow update, delete: if false;
    }

    // Material antifraude: publicarlo permitiria saber que imagenes estan ya
    // quemadas antes de intentar subirlas.
    /**
     * El contador que frena las escrituras de una cuenta (#62).
     *
     * Lo lleva el propio navegador, en el mismo lote que lo que escribe, y las
     * reglas de arriba comprueban como queda. Que lo escriba quien esta siendo
     * limitado suena mal y no lo es: aqui lo unico que se puede hacer es SUBIR
     * los contadores, y subirlos es lo que le cierra la puerta.
     *
     * Lo que NO se puede hacer, que es donde estaria el agujero:
     *
     *   - bajarlos ni dejarlos igual mientras se escribe un viaje, porque el id
     *     del viaje tiene que ser el numero nuevo;
     *   - subirlos de mas de uno en uno, asi que un lote no cabe mas que un
     *     viaje y una captura;
     *   - falsear el dia: tiene que ser el de `request.time`;
     *   - borrar el documento para empezar de cero.
     *
     * El reinicio diario se hace escribiendo el dia nuevo, y entonces los
     * contadores vuelven a empezar. Es la unica forma de que baje un contador.
     */
    match /cupos/{uid} {
      // Su dueño lo lee para saber por donde va; a nadie mas le dice nada.
      allow read: if esYo(uid) || esAdmin();

      allow create: if esYo(uid)
        && datos().keys().hasOnly(['dia', 'viajes', 'capturas'])
        && datos().dia == diaUTC()
        && datos().viajes is int && datos().viajes >= 0 && datos().viajes <= 1
        && datos().capturas is int && datos().capturas >= 0 && datos().capturas <= 1;

      allow update: if esYo(uid)
        && datos().keys().hasOnly(['dia', 'viajes', 'capturas'])
        && datos().dia == diaUTC()
        && datos().viajes is int && datos().capturas is int
        && datos().viajes <= topeDiario() && datos().capturas <= topeDiario()
        && (
          // Mismo dia: cada contador se queda igual o sube exactamente uno.
          (previo().dia == diaUTC()
            && datos().viajes >= previo().viajes
            && datos().viajes <= previo().viajes + 1
            && datos().capturas >= previo().capturas
            && datos().capturas <= previo().capturas + 1)
          // Dia nuevo: se reinicia, y como mucho con lo de este lote dentro.
          || (previo().dia != diaUTC()
            && datos().viajes >= 0 && datos().viajes <= 1
            && datos().capturas >= 0 && datos().capturas <= 1)
        );

      // Borrarlo seria la forma facil de reiniciar el contador.
      allow delete: if false;
    }

    match /huellas_captura/{hash} {
      allow read, write: if false;
    }

    // --- Clanes -------------------------------------------------------------
    match /clanes/{clanId} {
      allow read: if true;

      // Con mas gente deja de sentirse como un equipo y empieza a ser una lista.
      // El tope tambien impide que acabe todo el mundo en el mismo clan y el
      // mapa se quede sin partida.
      function cabeAlguienMas() {
        return datos().miembros.size() <= 50
          // Y cada uno UNA vez. `hasOnly` no mira repetidos, y la puntuacion
          // del clan suma la de cada entrada: un lider que se ponia cincuenta
          // veces a si mismo (o a quien le hubiera pedido entrar) multiplicaba
          // por cincuenta la nota del clan.
          && datos().miembros.toSet().size() == datos().miembros.size();
      }

      // Quien entra en la plantilla tiene que estar en las solicitudes. Antes el
      // lider podia meter el uid de cualquiera —por ejemplo, de los mejores del
      // ranking— y como la puntuacion del clan suma la de sus miembros, la
      // inflaba sin que nadie hubiera querido entrar. Por invitacion entra el
      // worker, que no pasa por aqui. Y el contador es el de la lista.
      function soloEntraQuienLoPide() {
        return datos().miembros.hasOnly(previo().miembros.concat(previo().solicitudes))
          // La lista de solicitudes solo la escribe quien pide entrar. El lider
          // la puede vaciar (aceptar o rechazar), nunca llenar: si no, metia ahi
          // el uid de cualquiera y en la escritura siguiente lo pasaba a la
          // plantilla, que es justo lo que este bloque tenia que impedir.
          && datos().get('solicitudes', []).hasOnly(previo().get('solicitudes', []))
          && (!('numMiembros' in datos()) || datos().numMiembros == datos().miembros.size());
      }

      // Texto publico: con tope y sin enlaces (el mismo patron que lemaSeguro).
      function textoLimpio(t, tope) {
        return t is string && t.size() <= tope
          && !t.lower().matches('(?s).*(https?://|www[.]|[a-z0-9-][.](com|es|net|org|io|me|ly|link|xyz|info|app|gg|co|tk|ru|cat|eu)([^a-z0-9]|$)).*');
      }

      // La identidad del clan, campo a campo, solo los que se tocan (`campos`):
      // las claves al crearlo, lo que cambia al editarlo. Las listas son las de
      // assets/data/emblemas-clan.js; un test las ata.
      function identidadValida(campos) {
        return (!('color' in campos) || datos().color.matches('^#[0-9a-fA-F]{6}$'))
          && (!('color2' in campos) || datos().color2 == null
              || (datos().color2 is string && datos().color2.matches('^#[0-9a-fA-F]{6}$')))
          && (!('patron' in campos) || datos().patron == null
              || datos().patron in ['mitad', 'diagonal', 'franja', 'rayas', 'cuartos', 'aro'])
          && (!('forma' in campos) || datos().forma in ['cuadro', 'circulo', 'hexagono', 'blason', 'octogono'])
          && (!('emblema' in campos) || datos().emblema == null
              || datos().emblema in ['rayo', 'llama', 'corona', 'estrella', 'montana', 'rueda', 'ola', 'diana', 'flecha', 'escudo', 'calavera', 'oso',
                                     'bici', 'pinon', 'casco', 'crono', 'timbre', 'pin', 'sol', 'luna', 'corazon', 'hoja', 'trofeo', 'semaforo'])
          && (!('siglas' in campos) || datos().siglas == null
              || (datos().siglas is string && datos().siglas.matches('^[A-Z0-9ÑÁÉÍÓÚ]{1,3}$')))
          && (!('descripcion' in campos) || textoLimpio(datos().descripcion, 80))
          && (!('zona' in campos) || textoLimpio(datos().zona, 30))
          && (!('presentacion' in campos) || textoLimpio(datos().presentacion, 200))
          // El clan no elige banner: su cabecera es su mapa. Solo el fondo.
          // (assets/js/mapa-clan.js).
          && (!('tema' in campos) || datos().tema in ['oscuro', 'claro'])
          // Como se entra (16e, "Entrada"): pidiendo permiso, libre o solo con
          // invitacion. Sin el campo, pidiendo permiso, como hasta ahora.
          && (!('entrada' in campos) || datos().entrada in ['permiso', 'libre', 'invitacion']);
      }

      function entradaDe(clan) {
        return clan.get('entrada', 'permiso');
      }

      function esLider() {
        return autenticado() && previo().lider == request.auth.uid;
      }

      // Un oficial gestiona la plantilla del dia a dia — aceptar solicitudes,
      // expulsar — pero NO puede tocar el liderazgo ni disolver el clan. Si
      // pudiera, ser oficial y ser lider serian lo mismo.
      function esOficial() {
        return autenticado()
          && previo().oficiales is list
          && previo().oficiales.hasAny([request.auth.uid]);
      }

      allow create: if autenticado()
        && puedeUsarLaWeb()
        && cuentaActiva()
        && datos().lider == request.auth.uid
        && datos().miembros == [request.auth.uid]
        && datos().oficiales.size() == 0
        && datos().solicitudes.size() == 0
        && datos().biciRating == 0
        && datos().logros.size() == 0
        && datos().nombre is string
        && datos().nombre.size() >= 3 && datos().nombre.size() <= 28
        && textoLimpio(datos().nombre, 28)
        // Lista cerrada. Sin ella, el clan nacia con los campos que quisiera
        // quien lo crea —un `numMiembros` de 9.999, una liga, un territorio—
        // y este documento lo lee cualquiera sin sesion.
        && datos().keys().hasOnly([
          'clanId', 'nombre', 'lider', 'miembros', 'oficiales', 'solicitudes',
          'biciRating', 'numMiembros', 'logros', 'creado',
          'color', 'color2', 'patron', 'forma', 'emblema', 'siglas',
          'descripcion', 'zona', 'presentacion', 'tema', 'entrada',
        ])
        && (!('clanId' in datos()) || datos().clanId == clanId)
        && (!('numMiembros' in datos()) || datos().numMiembros == 1)
        && (!('creado' in datos()) || datos().creado == request.time)
        // Quien ya esta en un clan no funda otro: saldria en la plantilla de
        // los dos y sumaria puntos a ambos.
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('clanId', null) == null
        && datos().color.matches('^#[0-9a-fA-F]{6}$')
        // La identidad con la que nace: las mismas formas que al cambiarla.
        && identidadValida(datos().keys());

      // --- Lo que puede el lider -------------------------------------------
      // Todo lo de un oficial, mas nombrarlos, ceder el liderazgo y cambiar la
      // identidad del clan.
      allow update: if esLider()
        && cambia().hasOnly([
          'miembros', 'solicitudes', 'numMiembros',
          'oficiales', 'lider', 'descripcion', 'color', 'emblema', 'siglas',
          'color2', 'patron', 'forma', 'zona', 'presentacion', 'tema', 'entrada',
        ])
        && cabeAlguienMas()
        && soloEntraQuienLoPide()
        // La identidad (assets/js/escudo-clan.js). Este documento es publico:
        // cada campo con su forma, y los textos sin enlaces.
        && identidadValida(cambia())
        // El nuevo lider tiene que estar dentro. Ceder el mando a alguien de
        // fuera deja el clan sin nadie que pueda gestionarlo.
        && (!('lider' in cambia()) || datos().miembros.hasAny([datos().lider]))
        // Y los oficiales, tambien.
        && (!('oficiales' in cambia()) || datos().miembros.hasAll(datos().oficiales));

      // --- Lo que puede un oficial ------------------------------------------
      allow update: if esOficial()
        && cambia().hasOnly(['miembros', 'solicitudes', 'numMiembros'])
        && cabeAlguienMas()
        && soloEntraQuienLoPide()
        // No puede echar al lider, ni echarse a si mismo del cargo por esta via.
        && datos().miembros.hasAny([previo().lider]);

      // --- Lo que puede cualquiera ------------------------------------------
      // Meter o sacar su PROPIA solicitud. Las dos comprobaciones juntas
      // significan "la unica diferencia entre las dos listas soy yo".
      //
      // Y con tope. Era la UNICA lista del esquema que no lo tenia: la
      // plantilla corta en 50, los oficiales tienen que estar dentro de la
      // plantilla, las rutas ancladas son tres. Esta crecia sin freno, y este
      // documento lo lee CUALQUIERA sin sesion (`allow read: if true`), asi que
      // cada solicitud pendiente se la descarga todo el que abra el clan. Al
      // final del camino un documento de Firestore se planta en 1 MiB y deja de
      // poder escribirse: el clan se quedaria congelado, sin poder aceptar a
      // nadie ni echar a nadie.
      //
      // 100 con una plantilla de 50 es de sobra. Y el tope no estorba para
      // RETIRAR una solicitud: quitar deja la lista mas corta, asi que sigue
      // cumpliendo aunque este llena.
      allow update: if autenticado()
        && cambia().hasOnly(['solicitudes'])
        && datos().solicitudes.size() <= 100
        // Pedir solo se puede en un clan que entra pidiendo permiso: en uno
        // libre se entra sin mas, y en uno de invitacion, con el enlace.
        // Retirar la propia solicitud se puede siempre.
        && (datos().solicitudes.size() <= previo().solicitudes.size() || entradaDe(previo()) == 'permiso')
        && datos().solicitudes.hasOnly(previo().solicitudes.concat([request.auth.uid]))
        && previo().solicitudes.hasOnly(datos().solicitudes.concat([request.auth.uid]));

      // Entrar en un clan libre: alguien sin clan se apunta a si mismo, al
      // final de la plantilla, y si tenia una solicitud pendiente se le quita.
      // Nada mas cambia: ni el lider, ni los oficiales, ni a nadie de dentro.
      allow update: if autenticado()
        && puedeUsarLaWeb()
        && cuentaActiva()
        && entradaDe(previo()) == 'libre'
        && cambia().hasOnly(['miembros', 'numMiembros', 'solicitudes'])
        && !previo().miembros.hasAny([request.auth.uid])
        && datos().miembros == previo().miembros.concat([request.auth.uid])
        && cabeAlguienMas()
        && datos().get('numMiembros', datos().miembros.size()) == datos().miembros.size()
        && datos().get('solicitudes', []).hasOnly(previo().get('solicitudes', []))
        && previo().get('solicitudes', []).hasOnly(datos().get('solicitudes', []).concat([request.auth.uid]))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('clanId', null) == null;

      // Irse del clan. Cualquiera puede, menos el lider: dejaria el clan sin
      // quien lo gestione. Antes tiene que ceder el mando o disolverlo.
      allow update: if autenticado()
        && cambia().hasOnly(['miembros', 'numMiembros', 'oficiales'])
        && previo().lider != request.auth.uid
        && previo().miembros.hasAny([request.auth.uid])
        && !datos().miembros.hasAny([request.auth.uid])
        // Y solo se saca a si mismo: el resto de la lista queda igual.
        && previo().miembros.hasOnly(datos().miembros.concat([request.auth.uid]))
        && datos().miembros.hasOnly(previo().miembros)
        // Lo mismo con los oficiales: solo puede salir el. Antes, al irse, se
        // podia escribir cualquier lista de oficiales y dejar a un compinche
        // con poder para expulsar a toda la plantilla.
        && datos().get('oficiales', []).hasOnly(previo().get('oficiales', []))
        && previo().get('oficiales', []).hasOnly(datos().get('oficiales', []).concat([request.auth.uid]))
        && (!('numMiembros' in datos()) || datos().numMiembros == datos().miembros.size());

      allow delete: if esLider();
    }

    // --- Invitaciones a un clan (#29) ---------------------------------------
    //
    // El id del documento ES el codigo del enlace, y es lo unico que hace falta
    // saber para entrar. Por eso NO se puede listar la coleccion: solo se puede
    // pedir un codigo concreto, que es como funciona un enlace de invitacion.
    //
    // Las escribe el navegador porque son del lider, pero quien las CONSUME no
    // las toca: aceptar una invitacion es que el lider te meta en `miembros`.
    // Marcarla como usada lo hace el worker, que es quien puede escribir en dos
    // documentos a la vez sin que el cliente decida el resultado.
    match /invitaciones/{codigo} {
      // `get` si, `list` no: sin esto, cualquiera se descarga todos los codigos
      // vigentes y se cuela en cualquier clan.
      allow get: if autenticado();
      allow list: if false;

      allow create: if autenticado()
        && datos().keys().hasOnly(['clanId', 'creadaPor', 'creada', 'caduca', 'usos', 'maxUsos'])
        && datos().creadaPor == request.auth.uid
        && get(/databases/$(database)/documents/clanes/$(datos().clanId)).data.lider == request.auth.uid
        && datos().usos == 0
        && datos().maxUsos is int
        && datos().maxUsos >= 1 && datos().maxUsos <= 50
        && datos().caduca is timestamp
        // Una invitacion eterna no es una invitacion, es una puerta abierta.
        && datos().caduca > request.time
        && datos().caduca < request.time + duration.value(30, 'd');

      // Retirarla antes de tiempo es cosa del lider.
      allow delete: if autenticado() && previo().creadaPor == request.auth.uid;

      // El contador de usos lo lleva el worker: si lo llevara el cliente, un
      // codigo de un solo uso valdria para todo el que lo tenga.
      allow update: if false;
    }

    // Peticion de usar un enlace de invitacion (#29).
    //
    // El navegador NO puede meterse solo en un clan: escribir en `clanes` es del
    // lider, y `invitaciones` no admite `update` de nadie. Asi que deja aqui la
    // peticion —"quiero entrar con este codigo"— y el worker la resuelve con el
    // Admin SDK, que si puede tocar el clan, el contador de usos y el perfil a
    // la vez sin que el cliente decida el resultado.
    //
    // El id del documento es el uid, a proposito: una peticion pendiente por
    // persona. Con id libre, cualquiera podria dejar mil peticiones con el mismo
    // codigo y vaciar los usos de una invitacion ajena.
    match /usos_invitacion/{uid} {
      allow read: if esYo(uid) || esAdmin();

      allow create: if esYo(uid)
        && datos().keys().hasOnly(['uid', 'codigo', 'estado', 'creada'])
        && datos().uid == uid
        && datos().codigo is string
        && datos().codigo.matches('^[0-9a-f]{16,64}$')
        // Nace pendiente y solo el worker la resuelve: si el cliente pudiera
        // escribir el resultado, escribiria "entrado".
        && datos().estado == 'pendiente'
        && datos().creada == request.time;

      // Reintentar es volver a crearla, y para eso hay que borrar la anterior:
      // asi no se puede cambiar el codigo de una peticion ya encolada.
      allow delete: if esYo(uid);
      allow update: if false;
    }

    match /estaciones_stats/{estacionId} {
      allow read: if true;
      allow write: if false;   // lo calcula el worker
    }

    // --- Configuracion ------------------------------------------------------
    // El interruptor de la web (assets/js/puerta.js). Lo lee cualquiera —es lo
    // que decide que pantalla ver— y solo lo cambia la administracion.
    match /config/acceso {
      allow read: if true;
      allow write: if esAdmin()
        && datos().keys().hasOnly(['modo', 'mensaje', 'actualizado', 'por'])
        && datos().modo in ['abierta', 'obras']
        && (!('mensaje' in datos()) || (datos().mensaje is string && datos().mensaje.size() <= 300))
        && datos().por == request.auth.uid
        && datos().actualizado == request.time;
    }

    // La lista blanca, por correo en minusculas. Cada uno solo puede mirar
    // SU entrada (asi la puerta sabe si pasa), nunca la lista: son correos.
    match /acceso_lista/{correo} {
      allow get: if esAdmin()
        || (autenticado() && request.auth.token.get('email', null) is string
            && request.auth.token.email.lower() == correo);
      allow list: if esAdmin();
      allow create, update: if esAdmin()
        && correo.matches('^[^@/ ]+@[^@/ ]+[.][^@/ ]+$')
        && datos().keys().hasOnly(['nota', 'por', 'creado'])
        && (!('nota' in datos()) || (datos().nota is string && datos().nota.size() <= 80))
        && datos().por == request.auth.uid;
      allow delete: if esAdmin();
    }

    match /config/general {
      allow read: if true;     // ruta destacada
      allow write: if esAdmin();
    }

    // --- Banners y lemas -------------------------------------------------------
    // Como se consigue cada uno: { items: { id: { tipo, logro? } } }, con tipo
    // 'manual' | 'evento' | 'logro'. Lo lee cualquiera (la pantalla de elegir
    // dice como se consigue lo que falta) y solo la cambia la administracion.
    // Lo que no esta aqui es 'manual'. El detalle de cada item se comprueba en
    // el navegador al leer: aqui solo se acota la forma y el tamaño.
    match /config/recompensas {
      allow read: if true;
      allow write: if esAdmin()
        && datos().keys().hasOnly(['items', 'actualizado', 'por'])
        && datos().items is map && datos().items.size() <= 80
        && datos().por == request.auth.uid
        && datos().actualizado == request.time;
    }

    // Los enlaces de evento: un documento por enlace, con el codigo (largo y
    // al azar) como id. Solo la administracion los ve, los crea y los borra; el
    // worker los marca como usados. Nadie mas puede LISTARLOS ni leerlos: quien
    // tiene el enlace lo canjea (abajo), no lo lee.
    //
    // Los de pegatina NFC (/admin/nfc/) son los mismos enlaces con dos datos
    // mas, solo para la administracion: `etiqueta` (donde esta la pegatina) y
    // `escrito` (cuando se grabo en ella). Es lo unico que se puede cambiar
    // desde la web; lo de canjeado lo pone el worker.
    function etiquetaNfcValida() {
      return !('etiqueta' in datos())
        || (datos().etiqueta is string && datos().etiqueta.size() <= 60);
    }

    match /recompensas_codigos/{codigo} {
      allow read, delete: if esAdmin();
      allow create: if esAdmin()
        && codigo.matches('^[A-Za-z0-9]{16,40}$')
        && datos().keys().hasOnly(['recompensa', 'creado', 'por', 'nfc', 'etiqueta'])
        && datos().recompensa is string && datos().recompensa.matches('^[a-z0-9-]{1,40}$')
        && (!('nfc' in datos()) || datos().nfc == true)
        && etiquetaNfcValida()
        && datos().por == request.auth.uid
        && datos().creado == request.time;
      allow update: if esAdmin()
        && cambia().hasOnly(['etiqueta', 'escrito', 'nfc'])
        && etiquetaNfcValida()
        && (!('nfc' in cambia()) || datos().nfc == true)
        && (!('escrito' in cambia()) || datos().escrito == request.time);
    }

    // "Quiero canjear este enlace": uno por piloto y de uno en uno, con el id
    // del piloto. El navegador solo PIDE; lo que decide si el codigo vale y se
    // lo da es el worker, que deja aqui el resultado. Mientras haya uno
    // pendiente no se puede mandar otro, asi que probar codigos al azar sale a
    // uno por pasada del worker.
    function canjeValido() {
      return datos().keys().hasOnly(['codigo', 'estado', 'creado'])
        && datos().codigo is string && datos().codigo.matches('^[A-Za-z0-9]{16,40}$')
        && datos().estado == 'pendiente'
        && datos().creado == request.time;
    }

    // Enlaces ya gastados, por la huella SHA-256 del codigo: el que llega tarde
    // lo sabe al abrirlo. Se pide uno a uno; listarlos no.
    match /codigos_gastados/{huella} {
      allow get: if true;
      allow list, write: if false;
    }

    match /canjes_recompensa/{uid} {
      allow read: if esYo(uid) || esAdmin();
      allow create: if esYo(uid) && canjeValido() && puedeUsarLaWeb() && cuentaActiva();
      allow update: if esYo(uid) && previo().estado != 'pendiente'
        && canjeValido() && puedeUsarLaWeb() && cuentaActiva();
      allow delete: if false;
    }

    // --- Tienda ---------------------------------------------------------------
    // Si se ve y que se vende. La lee cualquiera (la web decide si enseña el
    // acceso) y solo la cambia la administracion. Los precios de aqui son los
    // que se ENSEÑAN: lo que se cobra lo fija el enlace de pago de Stripe, y el
    // worker comprueba que lo cobrado cuadra antes de mandar nada a imprimir.
    match /config/tienda {
      allow read: if true;
      allow write: if esAdmin()
        && datos().keys().hasOnly(['visible', 'productos', 'gemas', 'actualizado', 'por'])
        && datos().visible is bool
        && datos().productos is map
        && datos().productos.keys().hasOnly(['camiseta', 'taza'])
        && (!('camiseta' in datos().productos) || productoTiendaValido(datos().productos.camiseta))
        && (!('taza' in datos().productos) || productoTiendaValido(datos().productos.taza))
        && (!('gemas' in datos()) || gemasTiendaValidas(datos().gemas))
        && datos().por == request.auth.uid
        && datos().actualizado == request.time;
    }

    // Un enlace de pago de Polar (o del entorno de pruebas), o nada.
    function enlacePolar(e) {
      return e is string && e.size() <= 200
        && (e == '' || e.matches('^https://(buy[.]polar[.]sh/polar_cl_[A-Za-z0-9]+|sandbox-api[.]polar[.]sh/v1/checkout-links/polar_cl_[A-Za-z0-9]+/redirect)$'));
    }

    function productoPolar(p) {
      return p.polarProducto is string && p.polarProducto.size() <= 80
        && enlacePolar(p.enlacePago)
        && (p.precio is int || p.precio is float) && p.precio >= 0 && p.precio <= 200;
    }

    function productoTiendaValido(p) {
      return p is map
        && p.keys().hasOnly(['activo', 'precio', 'enlacePago', 'polarProducto', 'variantes'])
        && p.activo is bool
        && productoPolar(p)
        && p.variantes is map && p.variantes.size() <= 12;
    }

    // Las gemas: hasta cuatro paquetes a la venta en Polar, y lo que cuesta en
    // gemas cada banner o lema (`precios`, id de recompensa -> gemas).
    function gemasTiendaValidas(g) {
      return g is map
        && g.keys().hasOnly(['packs', 'precios'])
        && g.packs is map && g.packs.size() <= 4
        && g.precios is map && g.precios.size() <= 60;
    }

    // Un pedido nace como borrador desde el navegador: que producto, que talla
    // y que viaje imprimir. Nada de lo que sale impreso viene de aqui: el
    // worker lo saca de la base de datos al cobrar, asi que no se puede pedir
    // una camiseta con un tiempo inventado. Cinco al dia por persona, por id.
    match /pedidos_tienda/{pedidoId} {
      allow read: if esAdmin() || (autenticado() && esYo(previo().uid));
      allow create: if autenticado()
        && esYo(datos().uid)
        && cuentaActiva()
        && puedeUsarLaWeb()
        && pedidoId.matches(request.auth.uid + '_' + string(diaUTC()) + '_[0-4]')
        && datos().keys().hasOnly(['uid', 'producto', 'variante', 'viajeId', 'envio', 'estado', 'creado'])
        && datos().producto in ['camiseta', 'taza', 'gemas']
        && datos().variante is string && datos().variante.size() <= 12
        && (!('viajeId' in datos()) || (datos().viajeId is string && datos().viajeId.size() <= 80))
        // Lo fisico lleva la direccion: la recogemos nosotros, Polar no.
        && (datos().producto == 'gemas' || envioValido(datos().envio))
        && datos().estado == 'borrador'
        && datos().creado == request.time;
      // La administracion solo marca lo que ha enviado a mano.
      allow update: if esAdmin()
        && cambia().hasOnly(['estado', 'enviadoEn'])
        && previo().estado in ['preparar', 'pagado', 'en_proveedor', 'en_produccion']
        && datos().estado == 'enviado';
      allow delete: if false;
    }

    function envioValido(e) {
      return e is map
        && e.keys().hasOnly(['nombre', 'direccion', 'direccion2', 'ciudad', 'provincia', 'cp', 'pais', 'telefono'])
        && e.keys().hasAll(['nombre', 'direccion', 'ciudad', 'cp', 'pais'])
        && e.nombre is string && e.nombre.size() >= 2 && e.nombre.size() <= 100
        && e.direccion is string && e.direccion.size() >= 3 && e.direccion.size() <= 120
        && e.get('direccion2', '') is string && e.get('direccion2', '').size() <= 120
        && e.ciudad is string && e.ciudad.size() >= 2 && e.ciudad.size() <= 60
        && e.get('provincia', '') is string && e.get('provincia', '').size() <= 60
        && e.cp is string && e.cp.matches('^[A-Za-z0-9 -]{3,12}$')
        && e.pais is string && e.pais.matches('^[A-Z]{2}$')
        && e.get('telefono', '') is string && e.get('telefono', '').matches('^[0-9 +()-]{0,20}$');
    }

    // Gastar gemas en un banner o un lema: el navegador PIDE y el worker decide
    // (backend/src/tienda.js, `procesarCanjesGemas`), igual que los enlaces de
    // evento. Una peticion a la vez por persona.
    function canjeGemasValido() {
      return datos().keys().hasOnly(['recompensa', 'estado', 'creado'])
        && datos().recompensa is string && datos().recompensa.matches('^[a-z0-9-]{1,40}$')
        && datos().estado == 'pendiente'
        && datos().creado == request.time;
    }

    match /canjes_gemas/{uid} {
      allow read: if esYo(uid) || esAdmin();
      allow create: if esYo(uid) && canjeGemasValido() && puedeUsarLaWeb() && cuentaActiva();
      allow update: if esYo(uid) && previo().estado != 'pendiente'
        && canjeGemasValido() && puedeUsarLaWeb() && cuentaActiva();
      allow delete: if false;
    }

    // Lo que el worker apunta de Polar (por donde va leyendo). Nadie mas.
    match /tienda_interno/{doc} {
      allow read, write: if false;
    }

    // Si la administracion exige los dos pasos. La lee quien tiene el rol
    // aunque aun no los tenga (para saber que le falta); encenderla solo se
    // puede con el segundo paso ya hecho, y APAGARLA no se puede desde la web:
    // solo desde la consola de Firebase. Quien robe una sesion no la quita.
    match /config/seguridad {
      allow read: if autenticado() && request.auth.token.admin == true;
      allow write: if autenticado() && request.auth.token.admin == true
        && segundoFactorReciente()
        && datos().keys().hasOnly(['adminMfa', 'por', 'actualizado'])
        && datos().adminMfa == true
        && datos().por == request.auth.uid
        && datos().actualizado == request.time;
    }

    match /config/{otro} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // --- Moderacion ---------------------------------------------------------
    // --- Denuncias (#61) ----------------------------------------------------
    //
    // El navegador denuncia UN VIAJE, no a una persona: manda `viajeId` y nada
    // mas. Antes tenia que mandar tambien `reportadoUid`, y eso obligaba a que
    // el uid del denunciado estuviera publicado en algun sitio desde el que
    // pudiera leerlo — o sea, a publicar los uid en las clasificaciones. Eso es
    // exactamente lo que la lista blanca de `agregados` prohibe desde #60.
    //
    // Quien es el dueño lo resuelve el worker, que si puede leer el viaje. Lo
    // que se pierde por el camino es la comprobacion de "no te denuncies a ti
    // mismo", que las reglas ya no pueden hacer: pasa al worker, que descarta la
    // denuncia sin encolarla. Se detecta mas tarde, pero no se pierde.
    match /reportes/{reporteId} {
      allow read: if esAdmin();

      allow create: if autenticado()
        && esYo(datos().reportanteUid)
        // Una por persona y viaje. Con id libre, una sola cuenta llenaba la
        // cola de denuncias con el mismo viaje mil veces.
        && reporteId == request.auth.uid + '_' + datos().viajeId
        && puedeUsarLaWeb()
        && cuentaActiva()
        && datos().keys().hasOnly(['viajeId', 'reportanteUid', 'motivo', 'estado', 'creado'])
        && datos().viajeId is string
        && datos().viajeId.size() > 0 && datos().viajeId.size() <= 64
        && datos().estado == 'sin_resolver'
        && datos().motivo is string
        && datos().motivo.size() >= 10
        && datos().motivo.size() <= 300
        && datos().creado == request.time;

      // `sin_resolver` -> `pendiente` lo hace el worker al rellenar a quien
      // señala; de ahi en adelante, la administracion.
      allow update: if esAdmin() && cambia().hasOnly(['estado', 'resueltoPor', 'resueltoEn']);
      allow delete: if false;
    }

    // El analisis del antifraude de cada viaje, con su riesgo, la gravedad de
    // cada señal y los mensajes con los numeros dentro.
    //
    // Vivia dentro del propio viaje, y las reglas dejan que su dueño lo lea
    // entero: quien abriera la consola del navegador tenia el manual del
    // antifraude, o sea cuanto puede acercarse a cada umbral sin saltarlo. En el
    // viaje se queda `motivos`, que son los codigos y nada mas.
    match /auditorias/{viajeId} {
      allow read: if esAdmin();
      // Lo escribe el worker con el Admin SDK, que se salta estas reglas.
      allow write: if false;
    }

    match /auditoria_admin/{registroId} {
      allow read: if esAdmin();
      allow create: if esAdmin();
      allow update, delete: if false;   // el rastro no se reescribe
    }

    // La coleccion `secrets` ya no existe: las claves viven en GitHub Secrets.
    // Se deja la regla explicita por si queda algun documento suelto del sistema
    // antiguo, para que siga siendo ilegible hasta que se borre.
    match /secrets/{doc} {
      allow read, write: if false;
    }

    // --- Cierre por defecto -------------------------------------------------
    // --- Agregados ---------------------------------------------------------
    // Lo que lee el navegador para pintar clasificaciones, mapa y portada.
    //
    // Publicos a proposito, y por eso solo llevan lo que ya se ve en pantalla:
    // nombre, avatar y puntos. Nunca correo ni nada que no salga ahi. Esa
    // limitacion no depende de esta regla, la impone `backend/src/agregados.js`
    // con una lista blanca de campos, y hay un test que la comprueba.
    //
    // Existen porque `usuarios` esta cerrada (#60) y porque leerla entera para
    // pintar un ranking costaba 175 lecturas por visita.
    match /agregados/{documento} {
      allow read: if true;
      // Los escribe el worker con el Admin SDK, que se salta estas reglas.
      allow write: if false;
    }

    // Consumo de cuota por dia (#38). Lo escribe el worker; el panel lo lee para
    // la grafica. No lleva nada de nadie, pero tampoco le sirve al navegador de
    // alguien que no administre.
    match /cuota/{dia} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Contadores diarios ya sumados. Solo administracion: el detalle de un dia
    // concreto no le hace falta a nadie mas.
    match /metricas/{dia} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Misiones del dia. Publicas y las MISMAS para todo el mundo: eso es lo que
    // permite leerlas con una sola lectura cacheable en vez de una por usuario.
    match /config/misiones/dias/{dia} {
      allow read: if true;
      // Las genera el worker. Que las escribiera el cliente permitiria
      // ponerse objetivos de un metro.
      allow write: if false;
    }

    // --- Analitica de producto ---------------------------------------------
    // Un documento por sesion, escrito al cerrar la pestaña. Sin sesion, igual
    // que los errores y por el mismo motivo: el embudo del registro hay que
    // medirlo antes de que exista la cuenta.
    //
    // No lleva NADA que identifique a nadie: solo contadores de eventos de una
    // lista cerrada. El id lo elige el navegador al azar y solo evita que dos
    // sesiones simultaneas se pisen.
    //
    // La lista de campos es la que impide que esto se convierta en un almacen
    // de lo que a cualquiera se le ocurra escribir.
    //
    // Lo que las reglas SI pueden hacer contra #67 sin pedir sesion, y hacen:
    //
    //   - solo `create`. El navegador escribe UNA vez por visita
    //     (`metricas.enviar` lleva guarda), asi que reescribir la misma sesion
    //     no lo hace nadie legitimo, y era la forma de inflar un contador a
    //     golpe de `increment` sobre el mismo documento
    //   - el id tiene la forma que genera el navegador y empieza por su dia
    //   - cada contador, entre 0 y 200: una visita no ve mil paginas
    //
    // Lo que NO pueden hacer es limitar cuantos documentos se crean: eso es App
    // Check (#4), y esta en docs/PUESTA-EN-MARCHA.md.
    function contadorDeSesion(k) {
      return !(k in datos()) || (datos()[k] is int && datos()[k] >= 0 && datos()[k] <= 200);
    }

    // El uso (assets/js/metricas.js, `uso`): marcas de una visita (0 o 1) y
    // segundos a la vista, con tope de dos horas por pagina.
    function marcaDeSesion(k) {
      return !(k in datos()) || (datos()[k] is int && datos()[k] >= 0 && datos()[k] <= 1);
    }
    function segundosDeSesion(k) {
      return !(k in datos()) || (datos()[k] is int && datos()[k] >= 0 && datos()[k] <= 7200);
    }

    match /sesiones_web/{sesion} {
      allow read: if esAdmin();
      allow delete: if esAdmin();

      allow create: if
        sesion.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9]{1,12}$')
        && sesion.split('_')[0] == datos().dia
        && contadorDeSesion('pagina_vista') && contadorDeSesion('subida_abierta')
        && contadorDeSesion('subida_con_foto') && contadorDeSesion('subida_enviada')
        && contadorDeSesion('subida_fallida') && contadorDeSesion('registro_abierto')
        && contadorDeSesion('registro_completado') && contadorDeSesion('login_completado')
        && datos().keys().hasOnly([
          'dia', 'version', 'creado',
          'pagina_vista', 'subida_abierta', 'subida_con_foto', 'subida_enviada',
          'subida_fallida', 'registro_abierto', 'registro_completado',
          'login_completado',
          'visitas',
          'd_movil',
          'd_escritorio',
          'f_directo',
          'f_instagram',
          'f_google',
          'f_otros',
          'con_cuenta',
          'segundos',
          's_portada',
          's_hoy',
          's_ranking',
          's_mapa',
          's_yo',
          's_subir',
          's_bici',
          's_info',
          's_otra',
          'v_portada',
          'v_hoy',
          'v_ranking',
          'v_mapa',
          'v_yo',
          'v_subir',
          'v_bici',
          'v_info',
          'v_otra'
        ])
        && marcaDeSesion('visitas')
        && marcaDeSesion('d_movil')
        && marcaDeSesion('d_escritorio')
        && marcaDeSesion('f_directo')
        && marcaDeSesion('f_instagram')
        && marcaDeSesion('f_google')
        && marcaDeSesion('f_otros')
        && marcaDeSesion('con_cuenta')
        && marcaDeSesion('v_portada')
        && marcaDeSesion('v_hoy')
        && marcaDeSesion('v_ranking')
        && marcaDeSesion('v_mapa')
        && marcaDeSesion('v_yo')
        && marcaDeSesion('v_subir')
        && marcaDeSesion('v_bici')
        && marcaDeSesion('v_info')
        && marcaDeSesion('v_otra')
        && segundosDeSesion('segundos')
        && segundosDeSesion('s_portada')
        && segundosDeSesion('s_hoy')
        && segundosDeSesion('s_ranking')
        && segundosDeSesion('s_mapa')
        && segundosDeSesion('s_yo')
        && segundosDeSesion('s_subir')
        && segundosDeSesion('s_bici')
        && segundosDeSesion('s_info')
        && segundosDeSesion('s_otra')
        && datos().dia is string && datos().dia.size() == 10
        && datos().version is string && datos().version.size() <= 20;
    }

    // --- Errores del cliente -----------------------------------------------
    // La otra coleccion que escribe gente SIN sesion, y tambien a proposito: un
    // fallo en el registro hay que verlo, y ahi todavia no hay cuenta.
    //
    // El id del documento es la HUELLA del error, no un id nuevo por incidencia.
    // Eso es lo que convierte un bucle de 500 errores iguales en un documento
    // con `veces: 500`, en vez de en 500 documentos.
    //
    // Riesgo que queda, dicho claro: cualquiera puede fabricar huellas y crear
    // documentos. Las reglas acotan el formato del id, los campos y los tamaños,
    // asi que cada documento es pequeño, pero no pueden limitar la frecuencia.
    // La poda periodica del worker es lo que acota el crecimiento a largo plazo.
    match /errores_cliente/{huella} {
      // Solo la administracion los lee: llevan rutas y trazas de la app.
      allow read: if esAdmin();
      allow delete: if esAdmin();

      allow create, update: if
        // El id tiene el formato que genera assets/js/errores.js.
        huella.matches('^e[a-z0-9]{1,12}$')
        && datos().keys().hasOnly([
          'mensaje', 'pila', 'pagina', 'navegador', 'version',
          'ancho', 'conSesion', 'sesiones', 'visto'
        ])
        && datos().mensaje is string && datos().mensaje.size() <= 300
        && datos().pila is string && datos().pila.size() <= 1000
        && datos().pagina is string && datos().pagina.size() <= 100
        && datos().navegador is string && datos().navegador.size() <= 40
        && datos().version is string && datos().version.size() <= 20
        && datos().ancho is int
        && datos().conSesion is bool
        // De uno en uno, que es lo que manda `errores.registrar`. Antes admitia
        // cualquier entero, o sea que un solo `update` ponia un fallo en
        // "le pasa a 50.000 personas" y lo subia al primer puesto de lo que
        // arreglar (#67).
        && datos().sesiones is int
        && datos().sesiones == (resource == null ? 1 : previo().sesiones + 1)
        && datos().visto == request.time
        // Sumar una sesion a un error no es reescribirlo. Sin esto, cualquiera
        // sin sesion cambiaba el mensaje y la pila de un error ya recogido, que
        // es lo que lee la administracion para decidir que arreglar.
        && (resource == null
          || (datos().mensaje == previo().mensaje && datos().pila == previo().pila));
    }

    // --- Foto de perfil --------------------------------------------------------
    // Aparte del perfil para que los rankings no la arrastren. El id es el
    // nombre de piloto (en minusculas), que es lo que conoce quien abre una
    // ficha; solo la escribe la cuenta que tiene ese nombre. Es una imagen ya
    // reducida en el navegador (assets/js/foto-perfil.js): como mucho 14.000
    // caracteres, y solo WebP o JPEG en base64 — nada de URLs, que harian que
    // el navegador de quien la ve pidiera algo a un servidor ajeno.
    match /fotos/{nombre} {
      allow read: if true;
      allow create, update: if autenticado()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.usernameLower == nombre
        && datos().keys().hasOnly(['uid', 'img', 'actualizado'])
        && datos().uid == request.auth.uid
        && datos().img is string && datos().img.size() <= 14000
        && datos().img.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/]+=*$')
        && datos().actualizado == request.time
        && puedeUsarLaWeb()
        && cuentaActiva();
      allow delete: if autenticado() && resource.data.uid == request.auth.uid;
    }

    // El banner y el lema que lleva puestos cada piloto en su ficha publica
    // (assets/js/vitrina.js). Como la foto: aparte del perfil, que es privado,
    // con el nombre en minusculas como id, y solo la escribe la cuenta de ese
    // nombre.
    //
    // No vale cualquier id: o uno `libre-*`, que son los de serie, o uno que
    // este en `recompensas` de su perfil (que el piloto no puede tocar), o uno
    // que la administracion ha atado a un logro (`config/recompensas`) cuando
    // ese logro ya esta en `logros`, que tampoco puede tocar. Asi un banner de
    // evento no se lo pone nadie que no lo haya ganado, aunque escriba aqui
    // desde la consola. Un id que no exista en el catalogo no rompe nada: el
    // navegador lo ignora y pinta el de serie.
    function recompensaValida(id) {
      return id == null
        || (id is string && id.size() <= 40 && id.matches('^[a-z0-9-]+$')
            && (id.matches('^libre-.*') || tieneRecompensa(id)));
    }

    function tieneRecompensa(id) {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('recompensas', []).hasAny([id])
        || get(/databases/$(database)/documents/config/recompensas).data.get('items', {}).get(id, {}).get('logro', '')
          in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('logros', []);
    }

    // Las redes de la ficha: solo el nombre de usuario de cada una, nunca una
    // URL (el enlace lo monta assets/js/redes.js con un dominio fijo). Mismos
    // patrones que `REDES` alli.
    function redesValidas(r) {
      return r is map
        && r.keys().hasOnly(['instagram', 'tiktok', 'strava', 'x'])
        && (!('instagram' in r) || (r.instagram is string && r.instagram.matches('^[A-Za-z0-9._]{1,30}$')))
        && (!('tiktok' in r) || (r.tiktok is string && r.tiktok.matches('^[A-Za-z0-9._]{2,24}$')))
        && (!('strava' in r) || (r.strava is string && r.strava.matches('^[0-9]{1,12}$')))
        && (!('x' in r) || (r.x is string && r.x.matches('^[A-Za-z0-9_]{1,15}$')));
    }

    match /vitrinas/{nombre} {
      allow read: if true;
      allow create, update: if autenticado()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.usernameLower == nombre
        && datos().keys().hasOnly(['uid', 'banner', 'lema', 'redes', 'desde', 'actualizado'])
        && datos().uid == request.auth.uid
        && recompensaValida(datos().banner)
        && recompensaValida(datos().lema)
        && redesValidas(datos().get('redes', {}))
        // La fecha de alta solo puede ser la de tu perfil: nadie se pone mas
        // antiguedad de la que tiene.
        && (datos().get('desde', null) == null
            || datos().desde == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('creado', null))
        && datos().actualizado == request.time
        && puedeUsarLaWeb()
        && cuentaActiva();
      allow delete: if autenticado() && resource.data.uid == request.auth.uid;
    }

    // --- Bicirating (11 · Bicis) ---------------------------------------------
    // La ficha de cada bici: la escribe el worker juntando las valoraciones, y
    // la lee cualquiera. No lleva autor (backend/src/bicis.js).
    match /bicis/{numero} {
      allow read: if true;
      allow write: if false;
    }

    // Una valoracion por piloto, bici y dia UTC: el id lo dice y la regla lo
    // comprueba, asi que no se puede votar dos veces la misma bici el mismo
    // dia, pero si cambiar la nota hasta medianoche (update, mismo id).
    //
    // Y solo con un viaje PROPIO detras: cada valoracion apunta a un trayecto
    // de quien la escribe, y la estacion es la de salida de ese trayecto. Sin
    // eso, cualquiera hundiria la nota de una bici sin haberla cogido nunca.
    // Como el viaje ya tiene su tope diario, las valoraciones tambien.
    match /valoraciones_bici/{valoracionId} {
      allow read: if autenticado() && resource.data.uid == request.auth.uid;
      allow create, update: if autenticado()
        && datos().keys().hasOnly(['bici', 'uid', 'dia', 'nota', 'fallos', 'comentario', 'viajeId', 'capturaId', 'estacion', 'procesada', 'creado'])
        && datos().uid == request.auth.uid
        && datos().bici is string && datos().bici.matches('^[1-9][0-9]{0,4}$')
        && datos().dia == diaUTC()
        && valoracionId == datos().bici + '_' + request.auth.uid + '_' + string(datos().dia)
        && datos().nota is int && datos().nota >= 1 && datos().nota <= 5
        && datos().fallos is list && datos().fallos.size() <= 9
        && datos().fallos.hasOnly(['frenos', 'asistencia', 'bateria', 'cambios', 'ruido', 'sillin', 'luces', 'cesta', 'rueda'])
        && datos().comentario is string && datos().comentario.size() <= 200
        // Sin enlaces (assets/js/bicis.js, `tieneEnlace`): es publico y anonimo.
        && !datos().comentario.lower().matches('(?s).*(https?://|www[.]|[a-z0-9-][.](com|es|net|org|io|me|ly|link|xyz|info|app|gg|co|tk|ru|cat|eu)([^a-z0-9]|$)).*')
        && (
          // Con un viaje suyo: la estacion es la de salida de ese viaje.
          (!('capturaId' in datos())
            && datos().viajeId is string && datos().viajeId.size() > 0 && datos().viajeId.size() <= 64
            && get(/databases/$(database)/documents/tiempos_viaje/$(datos().viajeId)).data.uid == request.auth.uid
            && datos().estacion == get(/databases/$(database)/documents/tiempos_viaje/$(datos().viajeId)).data.ruta.split('-')[0])
          // Sin viaje (11): la prueba es una captura suya, subida en el mismo
          // lote (y con el mismo cupo). El worker la lee: tiene que ser esa
          // bici y de hace menos de un mes, o la valoracion no cuenta.
          || (!('viajeId' in datos())
            && datos().capturaId is string && datos().capturaId.size() > 0 && datos().capturaId.size() <= 64
            && existsAfter(/databases/$(database)/documents/capturas/$(datos().capturaId))
            && getAfter(/databases/$(database)/documents/capturas/$(datos().capturaId)).data.uid == request.auth.uid
            && datos().estacion is string && datos().estacion.size() <= 4)
        )
        && datos().procesada == false
        && datos().creado == request.time
        && puedeUsarLaWeb()
        && cuentaActiva();
      allow delete: if false;
    }

    // --- Correos que pide alguien -------------------------------------------
    // Solo el worker sabe mandar correo. Estas dos colecciones son la forma de
    // pedirselo: se escribe un documento y la siguiente pasada lo envia y lo
    // borra (backend/worker.js, `enviarCorreosPedidos`).

    // Un mensaje de la administracion a un piloto, o el aviso de suspension.
    // Solo con el claim, y con el autor sellado: `por` tiene que ser quien
    // escribe, para que en el panel se sepa quien mando que.
    match /mensajes_equipo/{mensajeId} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && datos().keys().hasOnly(['uid', 'tipo', 'asunto', 'texto', 'sobre', 'firma', 'motivo', 'hasta', 'por', 'creado'])
        && datos().uid is string && datos().uid.size() > 0 && datos().uid.size() <= 128
        && datos().tipo in ['mensaje_equipo', 'cuenta_suspendida']
        && datos().por == request.auth.uid
        && datos().creado == request.time
        && (!('asunto' in datos()) || (datos().asunto is string && datos().asunto.size() <= 120))
        && (!('texto' in datos()) || (datos().texto is string && datos().texto.size() <= 4000))
        && (!('sobre' in datos()) || (datos().sobre is string && datos().sobre.size() <= 200))
        && (!('firma' in datos()) || (datos().firma is string && datos().firma.size() <= 80))
        && (!('motivo' in datos()) || (datos().motivo is string && datos().motivo.size() <= 500))
        && (!('hasta' in datos()) || datos().hasta == null || (datos().hasta is string && datos().hasta.size() <= 40))
        // Un mensaje sin texto no es un mensaje.
        && (datos().tipo != 'mensaje_equipo' || (datos().texto is string && datos().texto.size() >= 10));
      allow update, delete: if false;
    }

    // "Acabo de cambiar mi contraseña": cada uno el suyo, uno a la vez (el id
    // es el uid y no se puede reescribir mientras exista). El worker no se lo
    // cree sin mas: comprueba en Firebase Auth que el cambio es real y reciente,
    // y manda como mucho un aviso por hora.
    match /avisos_seguridad/{uid} {
      allow read, update, delete: if false;
      allow create: if esYo(uid)
        && datos().keys().hasOnly(['tipo', 'dispositivo', 'creado'])
        && datos().tipo == 'clave_cambiada'
        && datos().dispositivo is string && datos().dispositivo.size() <= 80
        && datos().creado == request.time;
    }

    // --- Bajas de correo ---------------------------------------------------
    // La UNICA coleccion del proyecto que escribe gente SIN sesion, y es a
    // proposito: el RGPD exige baja facil, y si hay que iniciar sesion para
    // darse de baja, no es baja facil.
    //
    // El id del documento es un token opaco que solo conoce quien ha recibido
    // el correo. El worker lo cambia por el usuario y apaga sus avisos. Nadie
    // puede leer esta coleccion, asi que no se puede raspar para averiguar
    // tokens ajenos, y no se puede sobrescribir ni borrar lo que otro ha
    // pedido.
    match /solicitudes_baja/{token} {
      allow read, update, delete: if false;

      allow create: if datos().keys().hasOnly(['creado'])
        // Un token corto se podria adivinar a base de intentos; uno largo, no.
        && token.size() >= 32
        && token.size() <= 128
        && token.matches('^[A-Za-z0-9_-]+$');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
